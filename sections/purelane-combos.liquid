{%- comment -%}
  Purelane — Best selling combos section
  Productionised from the `#combos` section of the purelane-homepage.html prototype.

  Notes for reviewers:
  - Each combo is a reusable block rendered by one Liquid loop. A combo holds up
    to five product-picker slots; only the filled slots render, and the product
    count is derived from them (never hardcoded).
  - Product title / image / URL / availability come from real Shopify products.
    Combo price, compare-at and savings are offer-level marketing values set per
    block (a bundle price is not the sum of the current product prices), so they
    are free-form text fields rather than product.price.
  - No JavaScript. The rail is a native CSS overflow-x scroller with scroll-snap;
    it is keyboard-scrollable and never causes page-level horizontal overflow.
  - All CSS is scoped to #shopify-section-{{ section.id }} so the section can be
    added, duplicated and reordered safely.
{%- endcomment -%}

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading_id = 'purelane-combos-heading-' | append: section.id
  assign combo_blocks = section.blocks | where: 'type', 'combo'
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --cb-ink: #17102b;
    --cb-body: rgba(36, 26, 61, 0.78);
    --cb-muted: rgba(36, 26, 61, 0.56);
    --cb-accent: #b8701c;
    --cb-accent-ink: #8a5410;
    --cb-leaf: #416812;
    --cb-line: rgba(75, 58, 143, 0.16);
    --cb-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --cb-maxw: 1180px;
    --cb-card: 302px;
  }

  #shopify-section-{{ section.id }} .purelane-combos {
    position: relative;
    padding: clamp(40px, 6vw, 72px) 0;
    background: linear-gradient(178deg, #f0fbf2 0%, #d9f2df 34%, #c3e9cf 72%, #b6e2c5 100%);
    color: var(--cb-body);
  }

  #shopify-section-{{ section.id }} .purelane-combos__wrap {
    max-width: var(--cb-maxw);
    margin: 0 auto;
    padding: 0 18px;
  }

  /* ---------- section head ---------- */
  #shopify-section-{{ section.id }} .purelane-combos__head {
    text-align: center;
    margin-bottom: 26px;
  }

  #shopify-section-{{ section.id }} .purelane-combos__kicker {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cb-muted);
  }

  #shopify-section-{{ section.id }} .purelane-combos__title {
    margin: 12px 0 0;
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: clamp(30px, 4.6vw, 54px);
    line-height: 0.94;
    letter-spacing: -0.018em;
    text-transform: uppercase;
    color: var(--cb-ink);
    overflow-wrap: break-word;
  }

  #shopify-section-{{ section.id }} .purelane-combos__rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    max-width: 240px;
    margin: 14px auto 0;
  }

  #shopify-section-{{ section.id }} .purelane-combos__rule i {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(75, 58, 143, 0.34));
  }

  #shopify-section-{{ section.id }} .purelane-combos__rule i:last-child {
    background: linear-gradient(90deg, rgba(75, 58, 143, 0.34), transparent);
  }

  #shopify-section-{{ section.id }} .purelane-combos__rule svg {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    color: var(--cb-accent);
  }

  #shopify-section-{{ section.id }} .purelane-combos__lede {
    max-width: 60ch;
    margin: 14px auto 0;
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.6;
    color: var(--cb-body);
  }

  #shopify-section-{{ section.id }} .purelane-combos__lede > * { margin: 0; }

  /* ---------- horizontal rail ---------- */
  #shopify-section-{{ section.id }} .purelane-combos__rail {
    display: flex;
    gap: 14px;
    /* bleed to the wrap edges, then re-pad, so cards can peek without page overflow */
    margin: 0 -18px;
    padding: 4px 18px 14px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .purelane-combos__rail::-webkit-scrollbar {
    display: none;
  }

  /* ---------- combo card ---------- */
  #shopify-section-{{ section.id }} .purelane-combos__card {
    flex: 0 0 var(--cb-card);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(158deg, rgba(255, 255, 255, 0.8), rgba(236, 230, 247, 0.56) 58%, rgba(222, 212, 240, 0.5));
    border: 1px solid var(--cb-line);
    box-shadow: 0 22px 54px rgba(58, 44, 112, 0.13), inset 0 1px 0 rgba(255, 255, 255, 0.92);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    backdrop-filter: blur(18px) saturate(140%);
    transition: transform 0.4s var(--cb-ease), box-shadow 0.4s var(--cb-ease);
  }

  #shopify-section-{{ section.id }} .purelane-combos__card.is-featured {
    border-color: rgba(201, 118, 29, 0.46);
    box-shadow: 0 22px 54px rgba(58, 44, 112, 0.14), 0 0 0 1px rgba(201, 118, 29, 0.24), inset 0 1px 0 rgba(255, 255, 255, 0.92);
  }

  @media (hover: hover) {
    #shopify-section-{{ section.id }} .purelane-combos__card:hover {
      transform: translateY(-5px);
    }
  }

  /* tray */
  #shopify-section-{{ section.id }} .purelane-combos__tray {
    position: relative;
    padding: 14px 14px 13px;
    background: linear-gradient(162deg, rgba(255, 255, 255, 0.56), rgba(236, 230, 247, 0.34));
    border-bottom: 1px solid rgba(75, 58, 143, 0.12);
  }

  #shopify-section-{{ section.id }} .purelane-combos__save {
    display: inline-block;
    margin-bottom: 13px;
    padding: 5px 11px;
    border-radius: 999px;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.84);
    border: 1px solid rgba(201, 118, 29, 0.34);
    color: var(--cb-leaf);
  }

  #shopify-section-{{ section.id }} .purelane-combos__flag {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 8.6px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: linear-gradient(135deg, #00706a, #004b46);
    color: #f4fdf6;
  }

  /* product tray tiles */
  #shopify-section-{{ section.id }} .purelane-combos__stack {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .purelane-combos__it {
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .purelane-combos__tile {
    display: block;
    text-decoration: none;
    border-radius: 9px;
  }

  #shopify-section-{{ section.id }} .purelane-combos__img {
    height: 66px;
    width: auto;
    max-width: 100%;
    margin: 0 auto 8px;
    object-fit: contain;
    filter: drop-shadow(0 5px 8px rgba(0, 74, 66, 0.13));
  }

  #shopify-section-{{ section.id }} .purelane-combos__img.placeholder-svg {
    height: 66px;
    width: auto;
    opacity: 0.5;
    filter: none;
  }

  #shopify-section-{{ section.id }} .purelane-combos__benefit {
    display: block;
    font-size: 8.6px;
    font-weight: 600;
    line-height: 1.32;
    color: var(--cb-body);
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .purelane-combos__oos {
    display: block;
    margin-top: 2px;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cb-muted);
  }

  #shopify-section-{{ section.id }} .purelane-combos__plus {
    flex: 0 0 9px;
    padding-bottom: 30px;
    font-size: 12px;
    font-weight: 800;
    text-align: center;
    color: var(--cb-accent);
  }

  /* body */
  #shopify-section-{{ section.id }} .purelane-combos__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 15px 16px 18px;
  }

  #shopify-section-{{ section.id }} .purelane-combos__name {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    color: var(--cb-ink);
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .purelane-combos__count {
    margin: 6px 0 0;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cb-muted);
  }

  #shopify-section-{{ section.id }} .purelane-combos__desc {
    flex: 1;
    margin: 11px 0 14px;
    font-size: 12.4px;
    line-height: 1.55;
    color: var(--cb-body);
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .purelane-combos__desc > * { margin: 0; }

  #shopify-section-{{ section.id }} .purelane-combos__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 9px;
    margin-bottom: 6px;
  }

  #shopify-section-{{ section.id }} .purelane-combos__price strong {
    font-family: var(--font-heading-family);
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--cb-ink);
  }

  #shopify-section-{{ section.id }} .purelane-combos__price s {
    font-size: 13px;
    color: var(--cb-muted);
  }

  #shopify-section-{{ section.id }} .purelane-combos__price em {
    font-style: normal;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(201, 118, 29, 0.14);
    border: 1px solid rgba(201, 118, 29, 0.34);
    color: var(--cb-leaf);
  }

  #shopify-section-{{ section.id }} .purelane-combos__fine {
    margin: 0 0 14px;
    font-size: 10.4px;
    color: var(--cb-muted);
  }

  /* CTA */
  #shopify-section-{{ section.id }} .purelane-combos__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 46px;
    margin-top: auto;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.35s var(--cb-ease), box-shadow 0.35s var(--cb-ease), background-color 0.35s var(--cb-ease);
  }

  #shopify-section-{{ section.id }} .purelane-combos__btn svg {
    flex: 0 0 auto;
    width: 15px;
    height: 15px;
  }

  #shopify-section-{{ section.id }} .purelane-combos__btn--ghost {
    background: rgba(255, 255, 255, 0.66);
    border: 1px solid rgba(75, 58, 143, 0.22);
    color: #01423b;
  }

  #shopify-section-{{ section.id }} .purelane-combos__btn--primary {
    background: linear-gradient(135deg, #00706a, #004b46);
    color: #f4fdf6;
    box-shadow: 0 12px 26px rgba(0, 80, 74, 0.26), inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }

  @media (hover: hover) {
    #shopify-section-{{ section.id }} .purelane-combos__btn--ghost:hover {
      transform: translateY(-2px);
      background: rgba(255, 255, 255, 0.9);
    }
    #shopify-section-{{ section.id }} .purelane-combos__btn--primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 36px rgba(0, 80, 74, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.28);
    }
  }

  /* focus states */
  #shopify-section-{{ section.id }} .purelane-combos a:focus-visible {
    outline: 2px solid var(--cb-accent-ink);
    outline-offset: 3px;
    border-radius: 10px;
  }

  /* swipe cue — visual only, hidden on wide screens */
  #shopify-section-{{ section.id }} .purelane-combos__cue {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cb-muted);
  }

  #shopify-section-{{ section.id }} .purelane-combos__cue svg {
    width: 14px;
    height: 14px;
    color: var(--cb-accent);
  }

  #shopify-section-{{ section.id }} .purelane-combos__note {
    max-width: 62ch;
    margin: 14px auto 0;
    text-align: center;
    font-size: 12px;
    color: var(--cb-muted);
  }

  #shopify-section-{{ section.id }} .purelane-combos__note > * { margin: 0; }

  #shopify-section-{{ section.id }} .purelane-combos__empty {
    flex: 1 1 100%;
    text-align: center;
    padding: 30px 16px;
    color: var(--cb-body);
  }

  #shopify-section-{{ section.id }} .purelane-combos .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- responsive ---------- */
  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} .purelane-combos__cue {
      display: none;
    }
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} {
      --cb-card: 268px;
    }
    #shopify-section-{{ section.id }} .purelane-combos__rail {
      margin: 0 -14px;
      padding: 4px 14px 12px;
    }
    #shopify-section-{{ section.id }} .purelane-combos__img,
    #shopify-section-{{ section.id }} .purelane-combos__img.placeholder-svg {
      height: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .purelane-combos__card,
    #shopify-section-{{ section.id }} .purelane-combos__btn {
      transition: none;
    }
    #shopify-section-{{ section.id }} .purelane-combos__card:hover,
    #shopify-section-{{ section.id }} .purelane-combos__btn:hover {
      transform: none;
    }
    #shopify-section-{{ section.id }} .purelane-combos__rail {
      scroll-behavior: auto;
    }
  }
  /* add-to-cart busy state (transient only; resting button design unchanged) */
  #shopify-section-{{ section.id }} .purelane-combos__btn[aria-busy="true"] {
    opacity: 0.65;
    pointer-events: none;
  }
{% endstyle %}

<section class="purelane-combos"{% if section.settings.heading != blank %} aria-labelledby="{{ heading_id }}"{% else %} aria-label="Best selling combos"{% endif %}>
  <div class="purelane-combos__wrap">
    <div class="purelane-combos__head">
      {%- if section.settings.kicker != blank -%}
        <span class="purelane-combos__kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="purelane-combos__title" id="{{ heading_id }}">{{ section.settings.heading | escape }}</{{ heading_tag }}>
      {%- endif -%}

      <div class="purelane-combos__rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z" />
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z" />
        </svg>
        <i></i>
      </div>

      {%- if section.settings.subheading != blank -%}
        <div class="purelane-combos__lede">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    {%- if combo_blocks.size > 0 -%}
      <ul class="purelane-combos__rail" role="list">
        {%- for block in combo_blocks -%}
          {%- liquid
            # Count and remember which slots are filled (drives the tile count).
            assign slot_count = 0
            for n in (1..5)
              assign key = 'product_' | append: n
              if block.settings[key] != blank
                assign slot_count = slot_count | plus: 1
              endif
            endfor

            assign btn_class = 'purelane-combos__btn--ghost'
            if block.settings.highlight
              assign btn_class = 'purelane-combos__btn--primary'
            endif

            assign cta_link = block.settings.cta_link | default: '#bundles'
            assign cta_label = block.settings.cta_label | default: 'Shop bundle'

            # Collect the first available variant id of each configured product,
            # skipping missing and sold-out products. Drives the add-to-cart CTA.
            assign cart_ids = ''
            for n in (1..5)
              assign key = 'product_' | append: n
              assign cp = block.settings[key]
              if cp != blank and cp.available
                assign cv = cp.selected_or_first_available_variant
                if cv != blank
                  if cart_ids == ''
                    assign cart_ids = cv.id | append: ''
                  else
                    assign cart_ids = cart_ids | append: ',' | append: cv.id
                  endif
                endif
              endif
            endfor
          -%}

          <li class="purelane-combos__card{% if block.settings.highlight %} is-featured{% endif %}" {{ block.shopify_attributes }}>
            <div class="purelane-combos__tray">
              {%- if block.settings.save_pill != blank -%}
                <span class="purelane-combos__save">{{ block.settings.save_pill | escape }}</span>
              {%- endif -%}
              {%- if block.settings.flag != blank -%}
                <span class="purelane-combos__flag">{{ block.settings.flag | escape }}</span>
              {%- endif -%}

              {%- if slot_count > 0 -%}
                <ul class="purelane-combos__stack" role="list">
                  {%- assign rendered = 0 -%}
                  {%- for n in (1..5) -%}
                    {%- assign key = 'product_' | append: n -%}
                    {%- assign product = block.settings[key] -%}
                    {%- if product != blank -%}
                      {%- if rendered > 0 -%}
                        <li class="purelane-combos__plus" role="presentation" aria-hidden="true">+</li>
                      {%- endif -%}
                      {%- assign bkey = 'benefit_' | append: n -%}
                      {%- assign benefit = block.settings[bkey] -%}
                      <li class="purelane-combos__it">
                        <a class="purelane-combos__tile" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                          {%- if product.featured_image -%}
                            {{
                              product.featured_image
                              | image_url: width: 200
                              | image_tag:
                                loading: 'lazy',
                                class: 'purelane-combos__img',
                                alt: '',
                                widths: '88, 132, 176, 220',
                                sizes: '48px'
                            }}
                          {%- else -%}
                            {{ 'product-1' | placeholder_svg_tag: 'purelane-combos__img placeholder-svg' }}
                          {%- endif -%}
                        </a>
                        {%- if benefit != blank -%}
                          <span class="purelane-combos__benefit">{{ benefit | escape }}</span>
                        {%- endif -%}
                        {%- unless product.available -%}
                          <span class="purelane-combos__oos">{{ 'products.product.sold_out' | t }}</span>
                        {%- endunless -%}
                      </li>
                      {%- assign rendered = rendered | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- elsif request.design_mode -%}
                <p class="purelane-combos__benefit">Select up to 5 products for this combo.</p>
              {%- endif -%}
            </div>

            <div class="purelane-combos__body">
              {%- if block.settings.title != blank -%}
                <h3 class="purelane-combos__name">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if slot_count > 0 -%}
                <p class="purelane-combos__count">
                  {%- if slot_count == 1 -%}1 product{%- else -%}{{ slot_count }} products{%- endif -%}
                </p>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="purelane-combos__desc">{{ block.settings.description }}</div>
              {%- endif -%}

              {%- if block.settings.price != blank or block.settings.compare_price != blank or block.settings.savings_label != blank -%}
                <div class="purelane-combos__price">
                  {%- if block.settings.price != blank -%}
                    <strong>{{ block.settings.price | escape }}</strong>
                  {%- endif -%}
                  {%- if block.settings.compare_price != blank -%}
                    <s>
                      <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                      {{ block.settings.compare_price | escape }}
                    </s>
                  {%- endif -%}
                  {%- if block.settings.savings_label != blank -%}
                    <em>{{ block.settings.savings_label | escape }}</em>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if section.settings.fine_print != blank -%}
                <p class="purelane-combos__fine">{{ section.settings.fine_print | escape }}</p>
              {%- endif -%}

              <a class="purelane-combos__btn {{ btn_class }}" href="{{ cta_link }}"{% if cart_ids != blank %} data-ple-add="{{ cart_ids }}"{% endif %}>
                {{ cta_label | escape }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M5 12h13m-5-6 6 6-6 6" />
                </svg>
              </a>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.swipe_cue != blank -%}
        <p class="purelane-combos__cue" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
            <path d="M5 12h13m-5-6 6 6-6 6" />
          </svg>
          {{ section.settings.swipe_cue | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.rail_note != blank -%}
        <div class="purelane-combos__note">{{ section.settings.rail_note }}</div>
      {%- endif -%}

    {%- elsif request.design_mode -%}
      <p class="purelane-combos__empty">Add a <strong>Combo</strong> block to start building your bundle rail.</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root || root.dataset.pleComboCart === '1') { return; }
    root.dataset.pleComboCart = '1';

    var cartUrl = {{ routes.cart_url | json }};
    var addUrl = {{ routes.cart_add_url | json }};

    root.addEventListener('click', function (event) {
      var btn = event.target.closest('.purelane-combos__btn[data-ple-add]');
      if (!btn || !root.contains(btn)) { return; }

      var items = (btn.getAttribute('data-ple-add') || '')
        .split(',')
        .map(function (s) { return s.trim(); })
        .filter(Boolean)
        .map(function (id) { return { id: id, quantity: 1 }; });
      if (!items.length) { return; } // nothing addable -> let the link fall back

      event.preventDefault();
      if (btn.getAttribute('aria-busy') === 'true') { return; } // guard double-clicks
      btn.setAttribute('aria-busy', 'true');

      fetch(addUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ items: items })
      })
        .then(function (res) {
          if (!res.ok) { throw new Error('cart-add-failed'); }
          return res.json();
        })
        .then(function () {
          window.location.href = cartUrl;
        })
        .catch(function () {
          btn.removeAttribute('aria-busy'); // restore so the shopper can retry
        });
    });
  })();
</script>

