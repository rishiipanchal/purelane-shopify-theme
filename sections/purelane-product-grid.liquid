{%- comment -%}
  Purelane — Product grid section
  Productionised from the `#shop` section of the purelane-homepage.html prototype.

  Notes for reviewers:
  - Products come from merchant-selected product blocks (product picker), never
    hardcoded. Add / remove / reorder blocks in the theme editor to change which
    products show and how many.
  - Shopify has no universal review data, so rating + review count are optional
    per-block settings; the rating row is hidden when they are empty.
  - No JavaScript. "Add to cart" is a native product form (posts to the cart and
    redirects), so it works without client JS. Products with multiple variants
    link to the product page ("Choose options") instead, and unavailable
    products show an accessible sold-out state rather than a broken add action.
  - All CSS is scoped to #shopify-section-{{ section.id }} so the section can be
    added, duplicated and reordered without clashing with other instances.
  - Typography uses the theme's own heading/body fonts; geometry (sizes, weights,
    spacing, radii, shadows) is taken from the prototype. Accent colours are
    darkened slightly from the prototype to meet WCAG AA on the light ground.
{%- endcomment -%}

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign heading_id = 'purelane-grid-heading-' | append: section.id
  assign cta_label = section.settings.cta_label | default: 'Add to cart'

  assign product_blocks = section.blocks | where: 'type', 'product'
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --pg-ink: #17102b;
    --pg-body: rgba(36, 26, 61, 0.78);
    --pg-muted: rgba(36, 26, 61, 0.56);
    --pg-accent: #b8701c;
    --pg-accent-ink: #8a5410;
    --pg-leaf: #416812;
    --pg-line: rgba(75, 58, 143, 0.16);
    --pg-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --pg-maxw: 1180px;
    --pg-radius: 20px;
  }

  #shopify-section-{{ section.id }} .purelane-grid {
    position: relative;
    padding: clamp(40px, 6vw, 72px) 0;
    background: linear-gradient(178deg, #f0fbf2 0%, #d9f2df 34%, #c3e9cf 72%, #b6e2c5 100%);
    color: var(--pg-body);
  }

  #shopify-section-{{ section.id }} .purelane-grid__wrap {
    max-width: var(--pg-maxw);
    margin: 0 auto;
    padding: 0 18px;
  }

  /* ---------- section head ---------- */
  #shopify-section-{{ section.id }} .purelane-grid__head {
    text-align: center;
    margin-bottom: 26px;
  }

  #shopify-section-{{ section.id }} .purelane-grid__kicker {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pg-muted);
  }

  #shopify-section-{{ section.id }} .purelane-grid__title {
    margin: 12px 0 0;
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: clamp(30px, 4.6vw, 54px);
    line-height: 0.94;
    letter-spacing: -0.018em;
    text-transform: uppercase;
    color: var(--pg-ink);
    overflow-wrap: break-word;
  }

  #shopify-section-{{ section.id }} .purelane-grid__subheading {
    max-width: 52ch;
    margin: 12px auto 0;
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.6;
    color: var(--pg-body);
  }

  #shopify-section-{{ section.id }} .purelane-grid__subheading > * { margin: 0; }

  #shopify-section-{{ section.id }} .purelane-grid__rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    max-width: 240px;
    margin: 14px auto 0;
  }

  #shopify-section-{{ section.id }} .purelane-grid__rule i {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(75, 58, 143, 0.34));
  }

  #shopify-section-{{ section.id }} .purelane-grid__rule i:last-child {
    background: linear-gradient(90deg, rgba(75, 58, 143, 0.34), transparent);
  }

  #shopify-section-{{ section.id }} .purelane-grid__rule svg {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    color: var(--pg-accent);
  }

  /* ---------- grid (2 → 3 → 4 columns) ---------- */
  #shopify-section-{{ section.id }} .purelane-grid__shelf {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 700px) {
    #shopify-section-{{ section.id }} .purelane-grid__shelf {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    #shopify-section-{{ section.id }} .purelane-grid__shelf {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ---------- card ---------- */
  #shopify-section-{{ section.id }} .purelane-grid__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 16px;
    border-radius: var(--pg-radius);
    background: linear-gradient(158deg, rgba(255, 255, 255, 0.8), rgba(236, 230, 247, 0.56) 58%, rgba(222, 212, 240, 0.5));
    border: 1px solid var(--pg-line);
    box-shadow: 0 22px 54px rgba(58, 44, 112, 0.13), inset 0 1px 0 rgba(255, 255, 255, 0.92);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    backdrop-filter: blur(18px) saturate(140%);
    transition: transform 0.4s var(--pg-ease), box-shadow 0.4s var(--pg-ease);
  }

  @media (hover: hover) {
    #shopify-section-{{ section.id }} .purelane-grid__card:hover {
      transform: translateY(-5px);
      box-shadow: 0 28px 60px rgba(58, 44, 112, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.92);
    }
  }

  /* image area */
  #shopify-section-{{ section.id }} .purelane-grid__shot {
    position: relative;
    display: grid;
    place-items: center;
    height: 150px;
    margin-bottom: 14px;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.6), rgba(236, 230, 247, 0.42));
    border: 1px solid rgba(75, 58, 143, 0.1);
  }

  #shopify-section-{{ section.id }} .purelane-grid__media {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    /* reserve the top badge band so the centred product never collides with it */
    padding-top: 22px;
  }

  #shopify-section-{{ section.id }} .purelane-grid__img {
    width: auto;
    max-width: 86%;
    height: auto;
    max-height: 82%;
    object-fit: contain;
    filter: drop-shadow(0 8px 13px rgba(0, 74, 66, 0.13));
  }

  /* SVG placeholder inherits the same footprint */
  #shopify-section-{{ section.id }} .purelane-grid__img.placeholder-svg {
    width: 70%;
    height: auto;
    max-height: 82%;
    opacity: 0.5;
    filter: none;
  }

  /* badges */
  #shopify-section-{{ section.id }} .purelane-grid__pill {
    position: absolute;
    top: 9px;
    left: 9px;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(201, 118, 29, 0.34);
    color: var(--pg-leaf);
  }

  #shopify-section-{{ section.id }} .purelane-grid__flag {
    position: absolute;
    top: 9px;
    right: 9px;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    background: rgba(36, 26, 61, 0.82);
    border: 1px solid rgba(36, 26, 61, 0.3);
    color: #f4fdf6;
  }

  #shopify-section-{{ section.id }} .purelane-grid__shot--sold .purelane-grid__img {
    opacity: 0.5;
    filter: grayscale(0.4) drop-shadow(0 8px 13px rgba(0, 74, 66, 0.1));
  }

  /* text */
  #shopify-section-{{ section.id }} .purelane-grid__name {
    margin: 0 0 7px;
    font-family: var(--font-heading-family);
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--pg-ink);
    /* Full product title wraps naturally; min-height keeps short titles aligned
       with taller ones across the row without truncating long names. */
    min-height: 2.4em;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .purelane-grid__name a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .purelane-grid__name a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .purelane-grid__rate {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 10px;
    font-size: 11.5px;
    color: var(--pg-body);
  }

  #shopify-section-{{ section.id }} .purelane-grid__rate b {
    color: var(--pg-accent-ink);
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .purelane-grid__star {
    color: var(--pg-accent);
  }

  /* price pinned to the bottom of the text stack */
  #shopify-section-{{ section.id }} .purelane-grid__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-top: auto;
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .purelane-grid__price strong {
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: 700;
    color: var(--pg-ink);
  }

  #shopify-section-{{ section.id }} .purelane-grid__price s {
    font-size: 12px;
    color: var(--pg-muted);
  }

  #shopify-section-{{ section.id }} .purelane-grid__save {
    font-style: normal;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--pg-leaf);
  }

  /* action */
  #shopify-section-{{ section.id }} .purelane-grid__form { margin: 0; }

  #shopify-section-{{ section.id }} .purelane-grid__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.66);
    border: 1px solid rgba(75, 58, 143, 0.22);
    color: #01423b;
    transition: transform 0.35s var(--pg-ease), background-color 0.35s var(--pg-ease);
  }

  @media (hover: hover) {
    #shopify-section-{{ section.id }} .purelane-grid__btn:not(:disabled):hover {
      transform: translateY(-2px);
      background: rgba(255, 255, 255, 0.9);
    }
  }

  #shopify-section-{{ section.id }} .purelane-grid__btn:disabled {
    cursor: not-allowed;
    opacity: 0.55;
    background: rgba(36, 26, 61, 0.06);
    border-color: rgba(36, 26, 61, 0.18);
    color: rgba(36, 26, 61, 0.7);
  }

  /* focus states */
  #shopify-section-{{ section.id }} .purelane-grid a:focus-visible,
  #shopify-section-{{ section.id }} .purelane-grid__btn:focus-visible {
    outline: 2px solid var(--pg-accent-ink);
    outline-offset: 3px;
    border-radius: 10px;
  }

  /* accessible text hidden visually */
  #shopify-section-{{ section.id }} .purelane-grid .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  #shopify-section-{{ section.id }} .purelane-grid__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px 16px;
    color: var(--pg-body);
  }

  /* smaller image box on narrow phones, matching the prototype */
  @media (max-width: 760px) {
    #shopify-section-{{ section.id }} .purelane-grid__shot {
      height: 126px;
    }
  }
{% endstyle %}

<section class="purelane-grid"{% if section.settings.heading != blank %} aria-labelledby="{{ heading_id }}"{% else %} aria-label="Products"{% endif %}>
  <div class="purelane-grid__wrap">
    <div class="purelane-grid__head">
      {%- if section.settings.kicker != blank -%}
        <span class="purelane-grid__kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="purelane-grid__title" id="{{ heading_id }}">{{ section.settings.heading | escape }}</{{ heading_tag }}>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="purelane-grid__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}

      <div class="purelane-grid__rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z" />
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z" />
        </svg>
        <i></i>
      </div>
    </div>

    <ul class="purelane-grid__shelf" role="list">
      {%- if product_blocks.size > 0 -%}
        {%- for block in product_blocks -%}
          {%- liquid
            assign product = block.settings.product
            assign has_product = false
            if product != blank
              assign has_product = true
            endif

            assign is_available = false
            if has_product and product.available
              assign is_available = true
            endif

            assign show_compare = false
            assign discount_pct = 0
            if has_product and product.compare_at_price > product.price
              assign show_compare = true
              assign discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
            endif

          -%}

          {%- if has_product or request.design_mode -%}
          <li class="purelane-grid__card" {{ block.shopify_attributes }}>
            <div class="purelane-grid__shot{% unless is_available or has_product == false %} purelane-grid__shot--sold{% endunless %}">
              {%- comment -%} Marketing pill is hidden on sold-out products; SOLD OUT takes priority. {%- endcomment -%}
              {%- unless has_product and is_available == false -%}
                {%- if block.settings.pill != blank -%}
                  <span class="purelane-grid__pill">{{ block.settings.pill | escape }}</span>
                {%- endif -%}
              {%- endunless -%}

              {%- if has_product and is_available == false -%}
                <span class="purelane-grid__flag">{{ 'products.product.sold_out' | t }}</span>
              {%- endif -%}

              {%- if has_product -%}
                <a class="purelane-grid__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                  {%- if product.featured_image -%}
                    {{
                      product.featured_image
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        class: 'purelane-grid__img',
                        alt: '',
                        widths: '160, 200, 260, 320, 400, 520',
                        sizes: '(min-width: 900px) 260px, (min-width: 700px) 30vw, 45vw'
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'purelane-grid__img placeholder-svg' }}
                  {%- endif -%}
                </a>
              {%- else -%}
                <span class="purelane-grid__media">
                  {{ 'product-1' | placeholder_svg_tag: 'purelane-grid__img placeholder-svg' }}
                </span>
              {%- endif -%}
            </div>

            <h3 class="purelane-grid__name">
              {%- if has_product -%}
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              {%- else -%}
                Select a product
              {%- endif -%}
            </h3>

            {%- if block.settings.rating != blank or block.settings.review_count != blank -%}
              <div class="purelane-grid__rate">
                {%- if block.settings.rating != blank -%}
                  <b>
                    <span class="purelane-grid__star" aria-hidden="true">★</span>
                    <span>{{ block.settings.rating | escape }}</span>
                    <span class="visually-hidden">out of 5</span>
                  </b>
                {%- endif -%}
                {%- if block.settings.review_count != blank -%}
                  <span aria-hidden="true">·</span>
                  <span>{{ block.settings.review_count | escape }} reviews</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if has_product -%}
              <div class="purelane-grid__price">
                <strong>{{ product.price | money }}</strong>
                {%- if show_compare -%}
                  <s>
                    <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                    {{ product.compare_at_price | money }}
                  </s>
                  {%- if discount_pct > 0 -%}
                    <em class="purelane-grid__save">{{ discount_pct }}% off</em>
                  {%- endif -%}
                {%- endif -%}
              </div>

              {%- if is_available == false -%}
                <button type="button" class="purelane-grid__btn" disabled>{{ 'products.product.sold_out' | t }}</button>
              {%- elsif product.has_only_default_variant -%}
                {%- form 'product', product, class: 'purelane-grid__form' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" name="add" class="purelane-grid__btn">
                    {{ cta_label | escape }}
                    <span class="visually-hidden">— {{ product.title | escape }}</span>
                  </button>
                {%- endform -%}
              {%- else -%}
                <a href="{{ product.url }}" class="purelane-grid__btn">
                  {{ 'products.product.choose_options' | t | default: 'Choose options' }}
                  <span class="visually-hidden">— {{ product.title | escape }}</span>
                </a>
              {%- endif -%}
            {%- endif -%}
          </li>
          {%- endif -%}
        {%- endfor -%}

      {%- elsif request.design_mode -%}
        {%- for i in (1..4) -%}
          <li class="purelane-grid__card">
            <div class="purelane-grid__shot">
              <span class="purelane-grid__media">
                {{ 'product-1' | placeholder_svg_tag: 'purelane-grid__img placeholder-svg' }}
              </span>
            </div>
            <h3 class="purelane-grid__name">Example product</h3>
            <div class="purelane-grid__price"><strong>{{ 1000 | money }}</strong></div>
            <span class="purelane-grid__btn" aria-hidden="true">{{ cta_label | escape }}</span>
          </li>
        {%- endfor -%}
        <li class="purelane-grid__empty">Add a <strong>Product</strong> block for each item you want to show.</li>
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Purelane product grid",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use H2 on a page that already has an H1 (e.g. the hero).",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Supporting text"
    },
    {
      "type": "header",
      "content": "Products",
      "info": "Add a Product block for each item. Reorder or remove blocks to control what appears."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Add-to-cart button label",
      "default": "Add to cart"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "pill",
          "label": "Badge",
          "info": "Optional label shown on the image, e.g. Best seller, Top rated, New."
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating",
          "info": "Optional, e.g. 4.8. Shopify has no native rating field, so this is set here."
        },
        {
          "type": "text",
          "id": "review_count",
          "label": "Review count",
          "info": "Optional, e.g. 237."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane product grid",
      "blocks": [
        { "type": "product", "settings": { "pill": "Best seller", "rating": "4.8", "review_count": "237" } },
        { "type": "product", "settings": { "pill": "Best seller", "rating": "4.8", "review_count": "254" } },
        { "type": "product", "settings": { "pill": "Top rated", "rating": "4.8", "review_count": "231" } },
        { "type": "product", "settings": { "pill": "New", "rating": "4.8", "review_count": "183" } },
        { "type": "product", "settings": { "pill": "Best seller", "rating": "4.8", "review_count": "237" } },
        { "type": "product", "settings": { "pill": "Best seller", "rating": "4.8", "review_count": "254" } },
        { "type": "product", "settings": { "pill": "Top rated", "rating": "4.7", "review_count": "198" } },
        { "type": "product", "settings": { "pill": "New", "rating": "4.9", "review_count": "142" } }
      ]
    }
  ]
}
{% endschema %}